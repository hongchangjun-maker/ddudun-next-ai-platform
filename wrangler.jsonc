{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ddudun-next-ai-platform",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
